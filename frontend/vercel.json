{
  "ignoreCommand": "node ../scripts/vercel-ignore-build.mjs ../VERSION",
  "rewrites": [
    {
      "source": "/painel/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/painel/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/painel",
      "destination": "/index.html"
    }
  ]
}
