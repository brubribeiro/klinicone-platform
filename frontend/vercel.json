{
  "ignoreCommand": "node ../scripts/vercel-ignore-build.mjs ../VERSION",
  "redirects": [
    {
      "source": "/painel",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/painel/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
