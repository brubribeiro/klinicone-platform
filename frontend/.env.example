# Desenvolvimento local (padrão)
VITE_API_URL=/api
# O Vite faz proxy de /api para http://localhost:3333 (vite.config.ts)

# Só use URL absoluta se não estiver rodando o frontend via Vite:
# VITE_API_URL=http://localhost:3333/api

VITE_GOOGLE_CLIENT_ID=

# Console super-admin (app `apps/admin-console`, deploy separado)
# Produção: https://admin.klinicone.com.br
VITE_ADMIN_URL=http://localhost:5175
# Alias legado (ainda lido se VITE_ADMIN_URL estiver vazio):
# VITE_ADMIN_CONSOLE_URL=http://localhost:5175

# Landing pública (opcional; links de volta ao site)
# Produção: https://klinicone.com.br
VITE_LANDING_URL=http://localhost:5174

# E-mail de contato da plataforma (opcional): "Fale com o administrador" no login,
# upgrade em "Meu plano" e CTAs "Falar com a gente" da landing pública
VITE_ADMIN_CONTACT_EMAIL=

# Sobrescreva em frontend/.env.local (gitignored). Veja .env.local.example
