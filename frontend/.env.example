# =============================================================================
# Painel da clínica (frontend/) — copie para frontend/.env
# URLs só por env; sem host de produção hardcoded no código.
# Ver docs/ambientes.md
# =============================================================================

# --- Local ---
VITE_APP_ENV=development
VITE_API_URL=/api
# O Vite faz proxy de /api para http://localhost:3333 (vite.config.ts)

VITE_GOOGLE_CLIENT_ID=

VITE_ADMIN_URL=http://localhost:5175
VITE_LANDING_URL=http://localhost:5174

VITE_ADMIN_CONTACT_EMAIL=

# --- Staging (app.dev.klinicone.com.br) ---
# VITE_APP_ENV=development
# VITE_API_URL=https://api.dev.klinicone.com.br/api
# VITE_GOOGLE_CLIENT_ID=
# VITE_ADMIN_URL=https://admin.dev.klinicone.com.br
# VITE_LANDING_URL=https://dev.klinicone.com.br

# --- Produção (app.klinicone.com.br) ---
# VITE_APP_ENV=production
# VITE_API_URL=https://api.klinicone.com.br/api
# VITE_GOOGLE_CLIENT_ID=
# VITE_ADMIN_URL=https://admin.klinicone.com.br
# VITE_LANDING_URL=https://klinicone.com.br

# Alias legado (ainda lido se VITE_ADMIN_URL estiver vazio): VITE_ADMIN_CONSOLE_URL
# Sobrescreva em frontend/.env.local (gitignored).
