# Referência para deploy de PRODUÇÃO (Render + Supabase/Neon). Não commitar valores reais.
# Configure no painel do Render. Staging usa o mesmo formato com hosts *.dev e APP_ENV=development.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

JWT_SECRET=
JWT_EXPIRES_IN=4h

PORT=3333
NODE_ENV=production
APP_ENV=production

# Hosts KlinicOne de produção (landing + www + app + admin).
CORS_ORIGIN=https://klinicone.com.br,https://www.klinicone.com.br,https://app.klinicone.com.br,https://admin.klinicone.com.br

# Client ID OAuth do projeto Google de produção (autorizar os hosts acima).
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=klinicone-platform
R2_PUBLIC_URL=
