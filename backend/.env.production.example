# Referência para deploy (Render + Neon). Não commitar valores reais.
# Configure estas variáveis no painel do Render.

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

JWT_SECRET=
JWT_EXPIRES_IN=4h

PORT=3333
NODE_ENV=production

# Hosts KlinicOne (landing + www + app + admin). API opcional em api.klinicone.com.br.
CORS_ORIGIN=https://klinicone.com.br,https://www.klinicone.com.br,https://app.klinicone.com.br,https://admin.klinicone.com.br

# Obrigatório: a API recusa subir sem Client ID válido (validação de audience do ID token).
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=klinicone-platform
R2_PUBLIC_URL=
