// Schema do banco - plataforma de gestão de clínica de estética
// Tudo em PostgreSQL via Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================
// CLÍNICAS (TENANTS)
// =========================

// Cada clínica é um tenant. Todos os dados da clínica têm tenantId; o client Prisma
// (src/tenancy) injeta e filtra o tenantId da requisição automaticamente.
// O default dbgenerated de tenantId nos models só existe para o client aceitar o create
// sem o campo: sem contexto de tenant ele vira NULL e o insert falha (NOT NULL).
model Tenant {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  // false = clínica suspensa: login e requisições dos usuários dela são recusados
  active      Boolean   @default(true)
  suspendedAt DateTime?
  // Plano contratado (preço/módulos/limites; cobrança automática fora do escopo)
  planId      String?
  // Módulos além do plano (Json string[]); efetivo = (plano ∪ extra) − denied
  featuresExtra  Json?
  // Módulos do plano que esta clínica não tem
  featuresDenied Json?
  specialties Json?
  foundedAt   DateTime? @db.Date
  legalName   String?
  document    String?
  phone       String?
  email       String?
  city        String?
  state       String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  plan                    Plan?                    @relation(fields: [planId], references: [id], onDelete: SetNull)
  appSettings             AppSetting[]
  roles                   Role[]
  users                   User[]
  workingHours            WorkingHours[]
  unavailabilities        Unavailability[]
  equipments              Equipment[]
  documents               Document[]
  documentTemplates       DocumentTemplate[]
  messageTemplates        MessageTemplate[]
  messageDispatches       MessageDispatch[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  patients                Patient[]
  patientPhotos           PatientPhoto[]
  patientMeasurements     PatientMeasurement[]
  procedures              Procedure[]
  procedureEquipments     ProcedureEquipment[]
  procedureMaterials      ProcedureMaterial[]
  packages                Package[]
  packageItems            PackageItem[]
  patientPackages         PatientPackage[]
  promotions              Promotion[]
  promotionProcedures     PromotionProcedure[]
  promotionPackages       PromotionPackage[]
  appointments            Appointment[]
  appointmentMaterials    AppointmentMaterial[]
  paymentMethods          PaymentMethod[]
  financialEntries        FinancialEntry[]
  recurringExpenses       RecurringExpense[]
  inventoryItems          InventoryItem[]
  auditLogs               AuditLog[]
  inventoryMovements      InventoryMovement[]
  goals                   Goal[]
  pendingTasks            PendingTask[]
  skincareProducts        SkincareProduct[]
  skincareRules           SkincareRule[]
  skincareRoutines        SkincareRoutine[]
  feedbackReports         FeedbackReport[]
  platformAuditLogs       PlatformAuditLog[]
  apiRequestErrors        ApiRequestError[]

  @@index([planId])
  @@map("tenants")
}

// Planos da plataforma (painel super-admin). Não é dado de clínica: sem tenantId.
model Plan {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  // Preço de referência (centavos); sem gateway/cobrança automática nesta versão
  priceCents  Int?
  currency    String   @default("BRL")
  // Módulos incluídos (Json string[] do catálogo em platform-features.ts)
  features    Json?
  // Limites aplicados pela API (src/plan-limits), ex.: { "maxUsers": 5, "maxPatients": 500, "storageGb": 5 } (null = ilimitado)
  limits      Json?
  // false = não pode ser atribuído a novas clínicas; quem já tem continua com ele
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants Tenant[]

  @@map("plans")
}

// Ações do super-admin no painel da plataforma (criar/editar/suspender clínicas, "entrar como").
// Não é dado de clínica: sem tenantId, fora do escopo automático; a clínica alvo fica em targetTenantId.
model PlatformAuditLog {
  id             String   @id @default(uuid())
  // TENANT_*, PLAN_*, CATALOG_*, TENANT_PLAN_CHANGE, TENANT_FEATURES_CHANGE, FEEDBACK_STATUS_CHANGE, ANNOUNCEMENT_*
  // (planos/catálogos/avisos: targetTenantId nulo, targetName = plano, item ou título do aviso)
  action         String
  actorId        String
  actorName      String
  actorEmail     String
  targetTenantId String?
  // Nome da clínica no momento da ação (continua legível se ela for renomeada)
  targetName     String?
  details        Json?
  createdAt      DateTime @default(now())

  targetTenant Tenant? @relation(fields: [targetTenantId], references: [id], onDelete: SetNull)

  @@index([targetTenantId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

// Observabilidade da API (painel super-admin): contagens e latência por hora e rota.
// Sem tenantId (não é dado de clínica) e sem nada da requisição além do padrão da rota.
model ApiRouteMetric {
  id         String   @id @default(uuid())
  // Início da hora (UTC)
  hour       DateTime
  method     String
  // Padrão da rota (/api/patients/:id), nunca a URL com ids
  route      String
  // Clínica da requisição; "" = sem clínica (login, super-admin, público)
  tenantKey  String   @default("")
  count      Int      @default(0)
  // Respostas 4xx e 5xx
  clientErrors Int    @default(0)
  serverErrors Int    @default(0)
  totalMs    Float    @default(0)
  maxMs      Int      @default(0)
  // Histograma de duração (requisições por faixa, em ms) para estimar o p95
  le50       Int      @default(0)
  le100      Int      @default(0)
  le250      Int      @default(0)
  le500      Int      @default(0)
  le1000     Int      @default(0)
  le2500     Int      @default(0)
  le5000     Int      @default(0)
  gt5000     Int      @default(0)

  @@unique([hour, method, route, tenantKey])
  @@index([hour])
  @@map("api_route_metrics")
}

// Últimos erros 5xx da API (painel super-admin). Só o tipo e a 1ª linha da mensagem, sem corpo nem parâmetros.
model ApiRequestError {
  id             String   @id @default(uuid())
  method         String
  route          String
  statusCode     Int
  durationMs     Int
  errorName      String?
  message        String?
  targetTenantId String?
  createdAt      DateTime @default(now())

  targetTenant Tenant? @relation(fields: [targetTenantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("api_request_errors")
}

enum AnnouncementKind {
  FEATURE // novidade
  FIX // correção
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENT
}

// Aviso do super-admin às clínicas (novidades/correções de um release). Não é dado de clínica:
// sem tenantId. Ao enviar, vira uma Notification PLATFORM_ANNOUNCEMENT para cada usuário das
// clínicas ativas; rascunhos podem ser gerados do RELEASE_NOTES.md (version + kind).
model PlatformAnnouncement {
  id             String             @id @default(uuid())
  // Versão do release de origem (null = aviso escrito à mão)
  version        String?
  kind           AnnouncementKind
  title          String
  body           String
  status         AnnouncementStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([version, kind])
  @@index([status, scheduledAt])
  @@map("platform_announcements")
}

// Catálogo global da plataforma (sem tenantId): categorias de documento/mensagem,
// gatilhos de mensagem, sugestões de procedimento e unidades de estoque.
// Todas as clínicas consomem o mesmo; só o super-admin edita em /admin.
model PlatformCatalogItem {
  id        String   @id @default(uuid())
  // document_category | message_category | message_trigger | procedure_category | inventory_unit | skincare_tag
  kind      String
  // Valor persistido nas entidades da clínica (slug / código)
  value     String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  // Ex.: { "color": "#C27C6B" }, { "defaultTrigger": "ON_BOOKING" }
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, value])
  @@index([kind, active, sortOrder])
  @@map("platform_catalog_items")
}

// =========================
// CONFIGURAÇÕES DO SISTEMA (chave-valor, por clínica)
// =========================
model AppSetting {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  key       String
  value     String
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, key])
  @@map("app_settings")
}

// =========================
// USUÁRIOS DO SISTEMA + GRUPOS (ROLES) CUSTOMIZÁVEIS
// =========================

// Grupo de permissões. Permissões são strings tipo "patients:view".
// Roles com isSystem=true não podem ser excluídas (seed garante 1 admin sempre).
model Role {
  id                        String   @id @default(uuid())
  tenantId                  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name                      String
  description               String?
  // Cor de identificação do grupo na tela de permissões (hex #RRGGBB).
  color                     String?
  permissions               String[]
  isSystem                  Boolean  @default(false)
  // Quando true, usuários desse grupo só veem/editam os próprios agendamentos.
  restrictToOwnAppointments Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  users User[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@map("roles")
}

model User {
  id                   String   @id @default(uuid())
  // Super-admin puro: tenantId e roleId nulos. Clínica (com ou sem isSuperAdmin dual): tenantId + roleId (CHECK users_tenant_or_super_admin_check).
  tenantId             String?
  name                 String
  // E-mail continua único no sistema inteiro: o login acha o usuário (e a clínica) pelo e-mail
  email                String   @unique
  password             String
  // Null só no super-admin puro; conta dual mantém o grupo da clínica
  roleId               String?
  isSuperAdmin         Boolean  @default(false)
  active               Boolean  @default(true)
  providesAppointments Boolean  @default(true) // false = não aparece em agendamentos (ex.: recepção)
  isPrimary            Boolean  @default(false) // profissional principal (usado para cálculo de custo/hora)
  // Perfil de profissional (preenchido quando providesAppointments = true)
  specialty            String? // função/título (ex.: Dermatologista, Biomédica esteta)
  specialties          String[] @default([]) // áreas de atuação (ex.: Toxina, Preenchimento)
  councilRegister      String? // registro do conselho (CRM/COREN/CRBM...)
  calendarColor        String? // cor de identificação na agenda (hex)
  bio                  String? // descrição/bio curta
  photoStorageKey      String? // chave da foto no Cloudflare R2
  photoUrl             String? // URL pública/derivada da foto
  // Última requisição autenticada (atualizada no máximo a cada poucos minutos); métrica do painel admin
  lastAccessAt         DateTime?
  // Incrementado no logout: JWTs com tv antigo deixam de ser aceitos (revogação de sessão)
  tokenVersion         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant                  Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role                    Role?                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  appointments            Appointment[]            @relation("ProfessionalAppointments")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  workingHours            WorkingHours[]
  unavailabilities        Unavailability[]
  feedbackReports         FeedbackReport[]
  pendingTasks            PendingTask[]            @relation("PendingTaskAssignee")

  @@index([tenantId])
  @@map("users")
}

// =========================
// HORÁRIOS DE ATENDIMENTO E INDISPONIBILIDADE
// =========================

// Horário fixo semanal de atendimento por profissional.
// dayOfWeek: 0 = domingo, 1 = segunda, ..., 6 = sábado.
model WorkingHours {
  id        String @id @default(uuid())
  tenantId  String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId    String
  dayOfWeek Int // 0..6
  startTime String // "08:00"
  endTime   String // "18:00"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, dayOfWeek])
  @@index([tenantId])
  @@map("working_hours")
}

// Bloqueios pontuais de agenda: férias, folga, compromisso, etc.
model Unavailability {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId    String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, startAt, endAt])
  @@index([tenantId])
  @@map("unavailabilities")
}

// =========================
// EQUIPAMENTOS / MÁQUINAS
// =========================
model Equipment {
  id                          String    @id @default(uuid())
  tenantId                    String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name                        String
  brand                       String?
  model                       String?
  serialNumber                String?
  purchaseDate                DateTime?
  // Valor de aquisição da máquina
  purchaseValue               Decimal?  @db.Decimal(10, 2)
  // Valor estimado de cada manutenção
  maintenanceValue            Decimal?  @db.Decimal(10, 2)
  // Intervalo padrão entre manutenções (em meses). Null = sem agendamento periódico.
  maintenanceIntervalMonths   Int?
  // Quantos dias antes da manutenção o sistema deve notificar
  maintenanceNotifyDaysBefore Int?
  lastMaintenanceAt           DateTime?
  // Próxima manutenção sugerida (gerada a partir de lastMaintenanceAt + intervalo)
  nextMaintenanceAt           DateTime?
  // Data agendada para a próxima manutenção (definida manualmente pelo usuário)
  scheduledMaintenanceAt      DateTime?
  notes                       String?
  active                      Boolean   @default(true)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  documents           Document[]
  financialEntries    FinancialEntry[]
  procedureEquipments ProcedureEquipment[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("equipment")
}

// =========================
// DOCUMENTOS (contratos, vigilância, certificados)
// =========================
model Document {
  id          String         @id @default(uuid())
  tenantId    String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name        String
  category    String? // ver DOCUMENT_CATEGORIES no frontend (consentimento, anamnese, contrato, ...)
  status      DocumentStatus @default(PENDING)
  signedAt    DateTime?
  storageKey  String?        @map("driveFileId") // chave no Cloudflare R2
  fileUrl     String?        @map("driveViewUrl") // URL pública do arquivo
  mimeType    String?
  size        Int? // bytes
  notes       String?
  // Texto gerado a partir de um modelo (placeholders já substituídos)
  content     String?
  templateId  String?
  // Vínculo opcional com paciente ou equipamento
  patientId   String?
  equipmentId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  patient   Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  equipment Equipment?        @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  template  DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([equipmentId])
  @@index([status])
  @@index([tenantId])
  @@map("documents")
}

enum DocumentStatus {
  PENDING // aguardando assinatura
  SENT // enviado ao paciente
  SIGNED // assinado / arquivo final
}

// Modelos de documento (termos, fichas, contratos) com placeholders {{paciente}}, {{cpf}}...
model DocumentTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name      String
  category  String?
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@map("document_templates")
}

// =========================
// MODELOS DE MENSAGEM (WhatsApp / e-mail)
// =========================

// Templates reutilizáveis para envio de mensagens.
// Suporta variáveis no formato {paciente_nome}, {data}, {hora}, {procedimento}, {profissional}.
/// Momento em que o modelo é usado (sugerido no envio pelo WhatsApp).
enum MessageTrigger {
  ON_BOOKING
  DAY_BEFORE
  BIRTHDAY
  AFTER_APPOINTMENT
  INACTIVE_90_DAYS
  MANUAL
}

model MessageTemplate {
  id          String         @id @default(uuid())
  tenantId    String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name        String
  category    String? // "confirmacao", "lembrete", "retorno", "aniversario", "livre"
  trigger     MessageTrigger @default(MANUAL)
  active      Boolean        @default(true)
  content     String
  procedureId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  procedure  Procedure?         @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  dispatches MessageDispatch[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@map("message_templates")
}

/// Fila / histórico de envios WhatsApp (MVP: deep link wa.me; registro evita duplicata por gatilho).
enum MessageDispatchStatus {
  PENDING
  SENT
  SKIPPED
}

enum MessageDispatchSource {
  AUTO
  MANUAL
}

model MessageDispatch {
  id                String                @id @default(uuid())
  tenantId          String                @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  templateId        String
  patientId         String
  appointmentId     String?
  trigger           MessageTrigger
  dedupKey          String
  phone             String?
  renderedMessage   String
  waMeUrl           String?
  status            MessageDispatchStatus @default(PENDING)
  source            MessageDispatchSource @default(AUTO)
  createdAt         DateTime              @default(now())
  sentAt            DateTime?

  template    MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, dedupKey])
  @@index([status, createdAt])
  @@index([tenantId])
  @@map("message_dispatches")
}

// =========================
// NOTIFICAÇÕES
// =========================
enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELLED
  INVENTORY_LOW_STOCK
  INVENTORY_EXPIRING
  PATIENT_CREATED
  PATIENT_RETURN_DUE
  PATIENT_REACTIVATION
  USER_CREATED
  EQUIPMENT_MAINTENANCE
  // Novidades/correções enviadas pelo super-admin (PlatformAnnouncement)
  PLATFORM_ANNOUNCEMENT
  // Report de bug/sugestão finalizado no /admin
  FEEDBACK_CLOSED
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String           @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String? // ex: "/agenda/abc-123" para navegação ao clicar
  read      Boolean          @default(false)
  readAt    DateTime?
  metadata  Json? // dados auxiliares (ex: appointmentId)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, read])
  @@index([createdAt])
  @@index([tenantId])
  @@map("notifications")
}

// Preferência por usuário e tipo. Default (quando não existe registro) = habilitado.
model NotificationPreference {
  id       String           @id @default(uuid())
  tenantId String           @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId   String
  type     NotificationType
  enabled  Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, type])
  @@index([tenantId])
  @@map("notification_preferences")
}

// =========================
// PACIENTES
// =========================
model Patient {
  id                  String    @id @default(uuid())
  tenantId            String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name                String
  email               String?
  phone               String?
  birthDate           DateTime?
  sex                 String? // "M" ou "F"
  document            String? // CPF
  cep                 String? // apenas dígitos persistidos pela API/front
  addressStreet       String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String? // UF
  addressNumber       String?
  addressComplement   String?
  address             String? // resumo legível (composto na API)
  notes               String? // observações gerais
  referralSource      String? // INSTAGRAM | REFERRAL | GOOGLE | LOCATION | OTHER
  referralSourceOther String? // detalhe quando referralSource = OTHER
  photoStorageKey     String? // chave no Cloudflare R2
  photoUrl            String? // URL pública da foto
  anamnesis           Json? // anamnese estruturada
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  appointments      Appointment[]
  financialEntries  FinancialEntry[]
  documents         Document[]
  packages          PatientPackage[]
  photos            PatientPhoto[]
  skincareRoutines  SkincareRoutine[]
  measurements      PatientMeasurement[]
  messageDispatches MessageDispatch[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("patients")
}

// Fotos "antes e depois" do paciente (armazenadas comprimidas no R2).
enum PatientPhotoPhase {
  BEFORE
  AFTER
}

model PatientPhoto {
  id            String            @id @default(uuid())
  tenantId      String            @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  patientId     String
  appointmentId String // sempre vinculada a um atendimento
  phase         PatientPhotoPhase
  label         String? // descrição opcional do conjunto
  pairId        String? // agrupa o "antes" e o "depois" do mesmo registro
  takenAt       DateTime          @default(now())
  storageKey    String // chave no Cloudflare R2
  mimeType      String?
  size          Int? // bytes
  createdAt     DateTime          @default(now())

  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([appointmentId])
  @@index([tenantId])
  @@map("patient_photos")
}

// Medidas corporais do paciente ao longo do tempo (IMC é calculado a partir de peso e altura).
model PatientMeasurement {
  id            String       @id @default(uuid())
  tenantId      String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  patientId     String
  appointmentId String? // consulta em que as medidas foram tomadas (opcional)
  measuredAt    DateTime
  weightKg      Decimal?     @db.Decimal(5, 2)
  heightCm      Decimal?     @db.Decimal(5, 1)
  waistCm       Decimal?     @db.Decimal(5, 1)
  abdomenCm     Decimal?     @db.Decimal(5, 1)
  hipCm         Decimal?     @db.Decimal(5, 1)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([patientId, measuredAt])
  @@index([appointmentId])
  @@index([tenantId])
  @@map("patient_measurements")
}

// =========================
// PROCEDIMENTOS / SERVIÇOS
// =========================
model Procedure {
  id              String   @id @default(uuid())
  tenantId        String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name            String
  description     String?
  category        String? // categoria livre (ex.: Facial, Injetáveis, Laser...)
  durationMinutes Int      @default(60)
  price           Decimal  @db.Decimal(10, 2)
  active          Boolean  @default(true)
  // Habilita o mapa de aplicação (marcação de pontos no atendimento)
  applicationMap  Boolean  @default(false)
  // Intervalo sugerido (em dias) para retorno do paciente. Null = sem retorno automático.
  recurrenceDays  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments     Appointment[]
  materials        ProcedureMaterial[]
  equipments       ProcedureEquipment[]
  messageTemplates MessageTemplate[]
  packageItems     PackageItem[]
  promotions       PromotionProcedure[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("procedures")
}

// Equipamentos usados num procedimento, com custo por uso informado manualmente.
model ProcedureEquipment {
  id          String  @id @default(uuid())
  tenantId    String  @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  procedureId String
  equipmentId String
  // Custo estimado por uso (R$), informado ao vincular
  costPerUse  Decimal @default(0) @db.Decimal(10, 2)

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([procedureId])
  @@index([equipmentId])
  @@index([tenantId])
  @@map("procedure_equipment")
}

// Materiais necessários para realizar um procedimento.
// Quando um agendamento ativo é criado, esses itens são deduzidos do estoque;
// quando cancelado/marcado como faltou, são devolvidos.
model ProcedureMaterial {
  id          String  @id @default(uuid())
  tenantId    String  @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  procedureId String
  itemId      String
  // Permite frações (ex: 0.5ml de hialurônico, 2.5g de pomada)
  quantity    Decimal @db.Decimal(12, 3)

  procedure Procedure     @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([procedureId, itemId])
  @@index([tenantId])
  @@map("procedure_materials")
}

// =========================
// PACOTES DE PROCEDIMENTOS
// =========================

enum PackageType {
  COMBO // vários procedimentos diferentes
  SESSIONS // X sessões do mesmo procedimento
}

enum PatientPackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

// Template/catálogo de pacote — define o que o pacote contém e condições.
model Package {
  id              String      @id @default(uuid())
  tenantId        String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name            String
  description     String?
  type            PackageType
  // Preço fixo do pacote (quando definido, ignora soma dos procedimentos)
  totalPrice      Decimal?    @db.Decimal(10, 2)
  // Desconto percentual sobre a soma dos procedimentos (alternativo ao totalPrice)
  discountPercent Decimal?    @db.Decimal(5, 2)
  // Validade em dias a partir da compra. Null = sem expiração.
  validityDays    Int?
  // Total de sessões (para SESSIONS: quantidade; para COMBO: soma dos items.quantity)
  sessionCount    Int         @default(1)
  active          Boolean     @default(true)
  // Destaque manual exibido no card: BEST_SELLER | RECURRING | null
  highlight       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           PackageItem[]
  patientPackages PatientPackage[]
  promotions      PromotionPackage[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("packages")
}

// Procedimentos que compõem o pacote.
model PackageItem {
  id          String @id @default(uuid())
  tenantId    String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  packageId   String
  procedureId String
  // Quantidade de sessões deste procedimento dentro do pacote
  quantity    Int    @default(1)
  // Ordem de exibição / execução sugerida
  sortOrder   Int    @default(0)

  package   Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([packageId, procedureId])
  @@index([tenantId])
  @@map("package_items")
}

// Vínculo de um pacote com um paciente (a "venda" / ativação).
model PatientPackage {
  id               String               @id @default(uuid())
  tenantId         String               @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  patientId        String
  packageId        String
  status           PatientPackageStatus @default(ACTIVE)
  // Preço efetivamente pago
  totalPaid        Decimal              @db.Decimal(10, 2)
  paymentMethod    String?
  purchaseDate     DateTime             @default(now())
  // Data de expiração (calculada: purchaseDate + package.validityDays)
  expiresAt        DateTime?
  // Controle de sessões consumidas
  sessionsTotal    Int
  sessionsUsed     Int                  @default(0)
  notes            String?
  // Receita do pacote já lançada no financeiro (antecipada ou no 1º atendimento concluído)
  financeGenerated Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id])
  package      Package       @relation(fields: [packageId], references: [id])
  appointments Appointment[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([status])
  @@index([tenantId])
  @@map("patient_packages")
}

// =========================
// PROMOÇÕES
// =========================

enum DiscountType {
  PERCENTAGE // desconto em percentual
  FIXED // desconto em valor fixo (R$)
  COMBO // promoção do tipo combo (sem valor de desconto direto)
}

// Promoção vinculada a datas comemorativas, procedimentos e/ou pacotes.
// Quando ativa e dentro do período, o desconto é aplicado automaticamente
// no lançamento financeiro ao completar um agendamento.
model Promotion {
  id                String       @id @default(uuid())
  tenantId          String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name              String
  description       String?
  // Data comemorativa associada (ex: "Dia das Mães", "Black Friday")
  commemorativeDate String?
  startAt           DateTime
  endAt             DateTime
  discountType      DiscountType
  // Valor do desconto: percentual (0-100) ou valor fixo em R$
  discountValue     Decimal      @db.Decimal(10, 2)
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  procedures   PromotionProcedure[]
  packages     PromotionPackage[]
  appointments Appointment[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([startAt, endAt])
  @@index([active])
  @@index([tenantId])
  @@map("promotions")
}

// Procedimentos participantes da promoção
model PromotionProcedure {
  id          String @id @default(uuid())
  tenantId    String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  promotionId String
  procedureId String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([promotionId, procedureId])
  @@index([tenantId])
  @@map("promotion_procedures")
}

// Pacotes participantes da promoção
model PromotionPackage {
  id          String @id @default(uuid())
  tenantId    String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  promotionId String
  packageId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  package   Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([promotionId, packageId])
  @@index([tenantId])
  @@map("promotion_packages")
}

// =========================
// AGENDAMENTOS
// =========================
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentKind {
  EVALUATION // avaliação inicial
  PROCEDURE // realização do procedimento
  RETURN // retorno
}

model Appointment {
  id                String            @id @default(uuid())
  tenantId          String            @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  patientId         String
  // Procedimento é opcional para Avaliação/Retorno (mas obrigatório quando kind = PROCEDURE)
  procedureId       String?
  professionalId    String
  startAt           DateTime
  endAt             DateTime
  status            AppointmentStatus @default(SCHEDULED)
  kind              AppointmentKind   @default(PROCEDURE)
  notes             String?
  clinicalNotes     String?
  // Controle de tempo real de atendimento
  startedAt         DateTime?
  finishedAt        DateTime?
  materialsDeducted Boolean           @default(false)
  financeGenerated  Boolean           @default(false)
  // Vínculo opcional com pacote do paciente (sessão consumida do pacote)
  patientPackageId  String?
  // Promoção aplicada automaticamente (se houver)
  promotionId       String?
  // Snapshot do mapa de aplicação (pontos marcados no atendimento), quando o procedimento usa
  applicationMap    Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  patient        Patient         @relation(fields: [patientId], references: [id])
  procedure      Procedure?      @relation(fields: [procedureId], references: [id])
  professional   User            @relation("ProfessionalAppointments", fields: [professionalId], references: [id])
  patientPackage PatientPackage? @relation(fields: [patientPackageId], references: [id])
  promotion      Promotion?      @relation(fields: [promotionId], references: [id])

  financialEntries  FinancialEntry[]
  extraMaterials    AppointmentMaterial[]
  photos            PatientPhoto[]
  measurements      PatientMeasurement[]
  messageDispatches MessageDispatch[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([startAt])
  @@index([patientId])
  @@index([patientPackageId])
  @@index([tenantId])
  @@map("appointments")
}

// Materiais extras utilizados em um agendamento específico (além do previsto no procedimento).
model AppointmentMaterial {
  id            String  @id @default(uuid())
  tenantId      String  @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  appointmentId String
  itemId        String
  quantity      Decimal @db.Decimal(12, 3)

  appointment Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, itemId])
  @@index([tenantId])
  @@map("appointment_materials")
}

// =========================
// FINANCEIRO
// =========================
enum FinancialType {
  INCOME
  EXPENSE
}

enum PaymentMethodKind {
  CASH
  PIX
  DEBIT
  CREDIT
  OTHER
}

// Formas de pagamento cadastráveis, com taxa da maquininha (feePercent).
// O valor líquido (netAmount) é calculado automaticamente ao gerar lançamento.
model PaymentMethod {
  id         String   @id @default(uuid())
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name       String
  kind       PaymentMethodKind @default(OTHER)
  // Dias até o recebimento na conta (conciliação / previsão de caixa)
  settlementDays Int  @default(0)
  // Taxa percentual cobrada pela operadora/maquininha (0 = sem taxa, ex: dinheiro/PIX)
  feePercent Decimal  @default(0) @db.Decimal(5, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  financialEntries FinancialEntry[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@map("payment_methods")
}

// Classifica despesas: fixas (aluguel, internet) vs variáveis (compra de material, taxa cartão)
enum ExpenseType {
  FIXED
  VARIABLE
}

model FinancialEntry {
  id                 String        @id @default(uuid())
  tenantId           String        @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  type               FinancialType
  description        String
  // Valor bruto do serviço/despesa
  amount             Decimal       @db.Decimal(10, 2)
  // Valor líquido após desconto da taxa da forma de pagamento
  netAmount          Decimal?      @db.Decimal(10, 2)
  // Taxa percentual aplicada (snapshot no momento do lançamento)
  feePercent         Decimal?      @db.Decimal(5, 2)
  paymentMethodId    String?
  // Dados opcionais de maquininha (cartão) no momento do lançamento
  installments       Int?
  cardBrand          String?
  authorizationCode  String?
  category           String?
  paidAt             DateTime?
  dueDate            DateTime?
  patientId          String?
  appointmentId      String?
  equipmentId        String?
  recurringExpenseId String?
  invoiceIssued      Boolean       @default(false)
  invoiceIssuedAt    DateTime?
  // Classificação de despesas (FIXED/VARIABLE). Nulo para receitas.
  expenseType        ExpenseType?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  patient          Patient?          @relation(fields: [patientId], references: [id])
  appointment      Appointment?      @relation(fields: [appointmentId], references: [id])
  equipment        Equipment?        @relation(fields: [equipmentId], references: [id])
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  paymentMethod    PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([paidAt])
  @@index([appointmentId])
  @@index([equipmentId])
  @@index([recurringExpenseId])
  @@index([paymentMethodId])
  @@index([tenantId])
  @@map("financial_entries")
}

// =========================
// DESPESAS RECORRENTES
// =========================

// Cadastro de despesas que se repetem mensalmente (aluguel, internet, seguro, etc.)
// O sistema gera automaticamente um FinancialEntry para cada mês.
model RecurringExpense {
  id          String      @id @default(uuid())
  tenantId    String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name        String
  description String?
  amount      Decimal     @db.Decimal(10, 2)
  category    String?
  expenseType ExpenseType @default(FIXED)
  // Dia do mês em que a despesa vence (1-31). Se o mês não tem esse dia, usa o último dia.
  dueDay      Int         @default(1)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  generatedEntries FinancialEntry[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("recurring_expenses")
}

// =========================
// ESTOQUE
// =========================
model InventoryItem {
  id                     String    @id @default(uuid())
  tenantId               String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name                   String
  sku                    String?
  description            String?
  // Quantidades agora aceitam fracionados (ex: 5.5 ml restantes de um pote de 100ml)
  quantity               Decimal   @default(0) @db.Decimal(12, 3)
  minQuantity            Decimal   @default(0) @db.Decimal(12, 3)
  unit                   String? // "ml", "un", "g"
  costPrice              Decimal?  @db.Decimal(10, 2)
  expiresAt              DateTime?
  // Quantos dias antes da validade o sistema deve notificar. Null = sem notificação.
  expiryNotifyDaysBefore Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  movements         InventoryMovement[]
  procedureUsages   ProcedureMaterial[]
  appointmentUsages AppointmentMaterial[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, sku])
  @@map("inventory_items")
}

// =========================
// AUDITORIA (histórico de alterações)
// =========================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  // Qual entidade foi alterada (ex: "Patient", "Appointment")
  entity    String
  // ID do registro alterado
  entityId  String
  action    AuditAction
  // Diff das alterações: { campo: { old: valor_anterior, new: valor_novo } }
  // Para CREATE: apenas new. Para DELETE: apenas old.
  changes   Json?
  // Usuário que realizou a alteração
  userId    String?
  userName  String?
  createdAt DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([tenantId])
  @@map("audit_logs")
}

// =========================
// FEEDBACK / REPORTES DE USUÁRIOS
// =========================

enum FeedbackType {
  BUG
  SUGGESTION
}

// Triagem pelo super-admin na central de reports (/admin/reports)
enum FeedbackStatus {
  OPEN
  TRIAGED
  CLOSED
}

model FeedbackReport {
  id          String       @id @default(uuid())
  tenantId    String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  type        FeedbackType
  title       String
  description String
  pageUrl     String?
  userId      String
  status      FeedbackStatus @default(OPEN)
  // Última troca de status (quem/quando fica na platform_audit_logs)
  statusChangedAt DateTime?
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@index([status])
  @@index([tenantId])
  @@map("feedback_reports")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model InventoryMovement {
  id        String       @id @default(uuid())
  tenantId  String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  itemId    String
  type      MovementType
  quantity  Decimal      @db.Decimal(12, 3)
  reason    String?
  // Data de validade do lote. Obrigatória para entradas (IN), pois lotes diferentes
  // do mesmo item podem ter validades distintas.
  expiresAt DateTime?
  createdAt DateTime     @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([tenantId])
  @@map("inventory_movements")
}

// =========================
// METAS
// =========================

// Indicador acompanhado pela meta. MANUAL = valor atual informado pelo usuário;
// os demais são calculados a partir dos dados do período (ver goals.service.ts).
enum GoalMetric {
  REVENUE // faturamento (receitas lançadas no financeiro)
  NEW_PATIENTS // pacientes cadastrados no período
  PROCEDURES // procedimentos realizados (agendamentos concluídos)
  AVERAGE_TICKET // faturamento ÷ atendimentos concluídos
  OCCUPANCY // % do expediente da equipe ocupado por agendamentos
  RETURN_RATE // % dos pacientes atendidos que já tinham atendimento anterior
  MANUAL
}

enum GoalFormat {
  CURRENCY
  NUMBER
  PERCENT
}

enum GoalPeriodType {
  MONTH
  QUARTER
  YEAR
}

model Goal {
  id          String         @id @default(uuid())
  tenantId    String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name        String
  metric      GoalMetric     @default(MANUAL)
  format      GoalFormat     @default(NUMBER)
  target      Decimal        @db.Decimal(12, 2)
  // Valor atual informado manualmente (usado só quando metric = MANUAL)
  manualValue Decimal?       @db.Decimal(12, 2)
  periodType  GoalPeriodType @default(MONTH)
  // Primeiro dia do período (mês, trimestre ou ano), sem horário
  periodStart DateTime       @db.Date
  color       String         @default("#15998B")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([periodStart])
  @@index([tenantId])
  @@map("goals")
}

// =========================
// CENTRAL DE PENDÊNCIAS
// =========================

/// Regras que geram pendências automaticamente a partir das outras telas.
enum PendingRule {
  LOW_STOCK
  EXPIRING_STOCK
  BILLS_DUE
  APPOINTMENT_NO_OUTCOME
  EQUIPMENT_MAINTENANCE
  DOCUMENT_UNSIGNED
  COMMEMORATIVE_DATE
}

enum PendingCategory {
  ADMINISTRATIVE
  FINANCE
  INVENTORY
  OPERATIONAL
  MAINTENANCE
  HEALTH_SURVEILLANCE
  MARKETING
  TEAM
  PATIENTS
  MANAGEMENT
}

/// Pendência manual, ou o estado (responsável/resolução) de uma pendência gerada por regra.
model PendingTask {
  id             String          @id @default(uuid())
  tenantId       String          @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  // Null = pendência manual
  rule           PendingRule?
  // Identifica a ocorrência gerada pela regra (ex.: "DOCUMENT:<id>"); muda quando a situação se repete
  sourceKey      String?
  title          String
  description    String?
  category       PendingCategory
  dueDate        DateTime?       @db.Date
  urgent         Boolean         @default(false)
  link           String?
  assigneeId     String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedByName String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  assignee User? @relation("PendingTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, sourceKey])
  @@index([resolvedAt])
  @@index([assigneeId])
  @@map("pending_tasks")
}

// =========================
// ROTINAS DE SKINCARE (anamnese de pele)
// =========================

/// Produto do catálogo usado para montar as rotinas.
model SkincareProduct {
  id               String   @id @default(uuid())
  tenantId         String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name             String
  brand            String?
  activeIngredient String?
  // manha | noite | semanal
  moments          String[] @default([])
  // limpeza | tratamento | hidratacao | protetor | olhos | esfoliacao | mascara
  step             String
  // Características usadas pelas restrições das regras (acido, acido-alto, retinoide, fragrancia, oleo)
  tags             String[] @default([])
  howTo            String?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("skincare_products")
}

/// Regra: quando a resposta da anamnese bate com field/value, inclui produtos, evita características e soma uma orientação.
model SkincareRule {
  id         String   @id @default(uuid())
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  // pele | afeccao | olheira | idade
  field      String
  value      String
  productIds String[] @default([])
  avoidTags  String[] @default([])
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("skincare_rules")
}

/// Anamnese de pele salva na ficha da paciente, com a rotina gerada (produtos copiados no momento do salvamento).
model SkincareRoutine {
  id            String   @id @default(uuid())
  tenantId      String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  patientId     String
  consultDate   DateTime @db.Date
  // { pele, afec[], afecOutra, olheira, olheiraTipo, idade }
  answers       Json
  // [{ moment, step, productId, name, brand, activeIngredient, howTo, note }]
  items         Json     @default("[]")
  // [{ productId, name, reason }]
  avoided       Json     @default("[]")
  // [{ text, source }]
  guidelines    Json     @default("[]")
  notes         String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([patientId, consultDate])
  @@index([tenantId])
  @@map("skincare_routines")
}
