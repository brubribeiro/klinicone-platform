# =============================================================================
# Backend — copie para backend/.env (gitignored) e preencha.
# Hosts e segredos só por variável de ambiente — sem default de produção no código.
# Ver docs/ambientes.md
# =============================================================================

DATABASE_URL=postgresql://klinicone:klinicone@localhost:5432/klinicone_platform?schema=public
DIRECT_URL=postgresql://klinicone:klinicone@localhost:5432/klinicone_platform?schema=public

POSTGRES_USER=klinicone
POSTGRES_PASSWORD=klinicone
POSTGRES_DB=klinicone_platform

JWT_SECRET=DEFINA_UM_SEGREDO_COM_PELO_MENOS_32_CARACTERES_AQUI
JWT_EXPIRES_IN=4h

PORT=3333

# --- Ambiente ---
# APP_ENV manda no health (`env: dev|prod`) e no seed demo.
# Em staging no Render: NODE_ENV=production + APP_ENV=development.
NODE_ENV=development
APP_ENV=development

# --- CORS (obrigatório; vários hosts separados por vírgula) ---
# Local:
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Staging (dev):
# CORS_ORIGIN=https://dev.klinicone.com.br,https://www.dev.klinicone.com.br,https://app.dev.klinicone.com.br,https://admin.dev.klinicone.com.br
# Produção:
# CORS_ORIGIN=https://klinicone.com.br,https://www.klinicone.com.br,https://app.klinicone.com.br,https://admin.klinicone.com.br

# OAuth Google — Client ID do ambiente (local / staging / prod). Obrigatório na subida.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=klinicone-platform
R2_PUBLIC_URL=

# Referência de produção: backend/.env.production.example
# Sobrescrita local: backend/.env.local (ver .env.local.example)
